APP_ENV=development

SEARCH_SERVICE_NAME=nexus-search
SEARCH_GRPC_PORT=50052
SEARCH_GRPC_REFLECTION_ENABLED=true
CORE_SERVICE_NAME=nexus-core
CORE_GRPC_PORT=50051
CORE_GRPC_REFLECTION_ENABLED=true
WORKER_SERVICE_NAME=nexus-worker

# Make reads the Go version from go.mod. Do not override it in .env.
# Host defaults; Compose sets container dependency addresses explicitly.
ELASTICSEARCH_ADDRESSES=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_PROPERTY_INDEX=nexus_estate_properties
ELASTICSEARCH_VERSION=8.14.3
ELASTICSEARCH_PORT=9200
ES_JAVA_OPTS=-Xms512m -Xmx512m
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SEARCH_TTL_SECONDS=60
REDIS_VERSION=7.2-alpine
REDIS_PORT=6379
